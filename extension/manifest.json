{
  "manifest_version": 3,
  "name": "钓鱼网站智能预警系统",
  "version": "1.0.0",
  "description": "基于大语言模型语义识别的钓鱼网站实时检测与预警插件",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://api.example.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "钓鱼网站检测"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}